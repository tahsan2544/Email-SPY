{
  "comment": "Public profile endpoints verified from the client. 'exists_status' is the HTTP status that proves the handle exists; 'missing_status' proves it does not. 'exists_body' requires that marker on a 200 before calling it exists; 'missing_body' catches soft-404 pages; 'probe_bytes' widens the body window when the marker sits deep in the HTML. 'core' marks the four mandatory platforms the social module always reports. Probes are only run for handles derived from the investigated address and are rate limited.",
  "sites": [
    {
      "id": "github",
      "name": "GitHub",
      "url": "https://api.github.com/users/{username}",
      "profile": "https://github.com/{username}",
      "exists_status": [200],
      "missing_status": [404],
      "extra_headers": {"Accept": "application/vnd.github+json"},
      "core": true
    },
    {
      "id": "instagram",
      "name": "Instagram",
      "url": "https://www.instagram.com/{username}/",
      "profile": "https://www.instagram.com/{username}/",
      "exists_status": [200],
      "exists_body": "property=\"og:title\"",
      "missing_body": "<title>\\s*Instagram\\s*</title>",
      "probe_bytes": 130000,
      "rate_limit": 1.0,
      "core": true
    },
    {
      "id": "x",
      "name": "X",
      "url": "https://x.com/{username}",
      "profile": "https://x.com/{username}",
      "exists_status": [200],
      "missing_status": [404],
      "rate_limit": 0.35,
      "core": true
    },
    {
      "id": "linkedin",
      "name": "LinkedIn",
      "url": "https://www.linkedin.com/in/{username}",
      "profile": "https://www.linkedin.com/in/{username}",
      "exists_status": [200],
      "missing_status": [404],
      "browser_ua": true,
      "rate_limit": 1.5,
      "core": true
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "url": "https://www.youtube.com/@{username}",
      "profile": "https://www.youtube.com/@{username}",
      "exists_status": [200],
      "missing_status": [404],
      "rate_limit": 0.5,
      "core": true
    },
    {
      "id": "gitlab",
      "name": "GitLab",
      "url": "https://gitlab.com/api/v4/users?username={username}",
      "profile": "https://gitlab.com/{username}",
      "exists_when": "json_list_nonempty",
      "missing_status": [200]
    },
    {
      "id": "mastodon",
      "name": "Mastodon",
      "url": "https://mastodon.social/api/v1/accounts/lookup?acct={username}",
      "profile": "https://mastodon.social/@{username}",
      "exists_status": [200],
      "missing_status": [404]
    },
    {
      "id": "bluesky",
      "name": "Bluesky",
      "url": "https://public.api.bsky.app/xrpc/app.bsky.actor.getProfile?actor={username}.bsky.social",
      "profile": "https://bsky.app/profile/{username}.bsky.social",
      "exists_status": [200],
      "missing_status": [400, 404]
    },
    {
      "id": "keybase",
      "name": "Keybase",
      "url": "https://keybase.io/_/api/1.0/user/lookup.json?username={username}",
      "profile": "https://keybase.io/{username}",
      "exists_when": "keybase_ok",
      "missing_status": [200]
    },
    {
      "id": "docker",
      "name": "Docker Hub",
      "url": "https://hub.docker.com/v2/users/{username}/",
      "profile": "https://hub.docker.com/u/{username}",
      "exists_status": [200],
      "missing_status": [404]
    },
    {
      "id": "hn",
      "name": "Hacker News",
      "url": "https://hn.algolia.com/api/v1/search?tags=author_{username}&hitsPerPage=1",
      "profile": "https://news.ycombinator.com/user?id={username}",
      "exists_when": "hn_authored",
      "missing_status": [200]
    },
    {
      "id": "soundcloud",
      "name": "SoundCloud",
      "url": "https://soundcloud.com/{username}",
      "profile": "https://soundcloud.com/{username}",
      "exists_status": [200],
      "missing_status": [404],
      "browser_ua": true,
      "rate_limit": 0.35
    },
    {
      "id": "linktree",
      "name": "Linktree",
      "url": "https://linktr.ee/{username}",
      "profile": "https://linktr.ee/{username}",
      "exists_status": [200],
      "missing_status": [404],
      "browser_ua": true,
      "rate_limit": 0.35
    }
  ]
}
